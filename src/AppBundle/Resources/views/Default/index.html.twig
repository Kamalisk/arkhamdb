{% extends 'AppBundle::layout.html.twig' %}
{% import "AppBundle::macros.html.twig" as macros %}

{% block body %}

<div class="main container">
<h1 class="site-title hidden-xs">ArkhamDB</h1>
<div class="site-slogan">{% trans %}Deckbuilder and Card Database for the Arkham Horror LCG{% endtrans %}</div>
</div> <!-- .container -->

<style>
	.box {
		margin: 5px;
		overflow: hidden;
		border-radius : 5px;
		border: solid grey 1px;
		background-color: #fcfcfc;
	}

	.dark .box {
		background-color: #131313;
  	color: #E0E0E0;
	}

	.front-block {
		display: flex;
		align-items: stretch;
		flex-direction: row;
		justify-content: space-between;
		gap: 0.4rem;
	}
	.front-block > div {
		flex: 1;
	}

	.front-decklist-list {
		display: flex;
		flex-direction: column;
		border-radius: 5px;
		padding: 0.5rem;
	}

	.front-decklist-list header {
		display: flex;
		align-items: center;
		gap: 1rem;
		justify-content: space-between;
		padding: 1rem;
	}

	.card-day-decklists {
		display: grid;
		grid-template-columns: 1fr 1fr;
	}
	@media (max-width:992px){
		.front-block {
			flex-direction: column;
		}
		.card-day-decklists {
			display: flex;
			flex-direction: column;
		}
	}

</style>

<div class="main container front-block">
	<div class="front-decklist-list">
		<header>
			<div>
				<h5 style="font-size: 16px; padding: 0;"></h5>
				<h4 style="font-size: 30px; display: flex; align-items: center; gap: 1rem; justify-content: space-between; margin: 0;">
					<a href="/decklists?sort=popular">Popular Decks</a>
				</h4>
			</div>
		</header>
		{% for data in decklists_by_popular %}
			{{ macros.decklist_block(data) }}
		{% endfor %}
	</div>

	{{ macros.investigator_highlight(investigator_highlight, decklists_by_investigator) }}

	<div class="front-decklist-list">
		<header>
			<div>
				<h5 style="font-size: 16px; padding: 0;"></h5>
				<h4 style="font-size: 30px; display: flex; align-items: center; gap: 1rem; justify-content: space-between; margin: 0;">
					<a href="/decklists?sort=date">Recent Decks</a>
				</h4>
			</div>
		</header>
		{% for data in decklists_by_recent %}
			{{ macros.decklist_block(data) }}
		{% endfor %}
	</div>
</div>

<div class="main container">
	<h3>Recent Pack Releases</h3>
	<ul>
		{% for pack in packs %}
		<li>
			{{pack.name}}
		</li>
		{% endfor %}
	</ul>
</div> <!-- .container -->

<div class="main container">
<h3>Recent Updates</h3>
<ul>
	<li>
		<h4>Taboos</h4>
		Can now set your deck to use the Taboo List, this will show XP and other card changes to help build your deck.
		Selecting the Taboo List as default is coming soon.
	</li>
	<li>
		<h4>Campaign Rewards</h4>
		If a campaign lets you add a regular player card that does not count towards your deck limit, you can do so by opening the card popup
		and manually adjust how many of that card ignore your deck limit.
	</li>
	<li>
		<h4>Ultimatum of Chaos</h4>
		You can create random decks with the chaos button found in the deck builder.
	</li>
	<li>
		<h4>Card Ownership</h4>
		You can set which packs you own in the collection manager (see My Collection in the user menu). When looking at decks, any
		cards in packs you do not own will be highlighted with a <span class="fa fa-question"></span>
	</li>
</ul>
</div> <!-- .container -->

{% endblock %}

{% block javascripts %}
<script type="application/ld+json">
{
	 "@context": "http://schema.org",
	 "@type": "WebSite",
	 "url": "https://arkhamdb.com/",
	 "potentialAction": {
		 "@type": "SearchAction",
		 "target": "http://arkhamdb.com/find?q={search_term_string}",
		 "query-input": "required name=search_term_string"
	 }
}
</script>
{% endblock %}
